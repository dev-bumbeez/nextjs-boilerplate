# URL de l'API Bumbeez, appelée côté serveur pour rendre les fiches offreurs.
# Volontairement sans préfixe NEXT_PUBLIC_ : l'API n'est jamais appelée depuis
# le navigateur, le rendu est serveur (nécessaire pour les aperçus sociaux,
# dont les robots n'exécutent pas de JavaScript).
API_URL=https://bumbeez-api-production-2004.up.railway.app

# --- Universal Links / App Links (étape B) ---
# Tant que ces deux variables sont absentes, les fichiers .well-known renvoient
# 404 : mieux vaut aucune association qu'une association erronée, que les OS
# mettent en cache durablement.

# Team ID Apple (10 caractères). developer.apple.com → Membership.
APPLE_TEAM_ID=

# Empreinte SHA-256 de la clé de signature **Play App Signing** (PAS la clé
# d'upload). `eas credentials` → Android → production, ou Play Console →
# Intégrité de l'app. Format : AA:BB:CC:...
ANDROID_CERT_SHA256=
